{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amare.local/contracts/engine-command.schema.json",
  "title": "EngineCommand",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "kind"],
  "properties": {
    "request_id": { "type": "string", "minLength": 1 },
    "tab_id": { "type": ["string", "null"] },
    "profile_id": { "type": ["string", "null"] },
    "kind": {
      "type": "string",
      "enum": [
        "create_tab",
        "close_tab",
        "activate_tab",
        "navigate",
        "go_back",
        "go_forward",
        "reload",
        "stop",
        "find",
        "set_zoom",
        "suspend",
        "resume",
        "download",
        "set_permission",
        "clear_data",
        "extract_content",
        "agent_action",
        "capture_screenshot"
      ]
    },
    "payload": { "type": "object", "default": {} }
  }
}
