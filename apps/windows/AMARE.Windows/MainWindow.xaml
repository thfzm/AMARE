<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Amare.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:Amare.Windows.Core"
    xmlns:local="using:Amare.Windows"
    Title="AMARE">
    <Grid x:Name="RootGrid" Loaded="RootGrid_Loaded" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.Resources>
            <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <Style x:Key="ToolbarButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="34" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
            <Style x:Key="TabCloseButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="24" />
                <Setter Property="Height" Value="24" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="6" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="46" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="24" />
        </Grid.RowDefinitions>

        <!-- Top tabs -->
        <Grid Grid.Row="0" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ListView
                x:Name="TabList" AutomationProperties.AutomationId="TabList"
                Grid.Column="0"
                Margin="8,4,4,4"
                SelectionMode="Single"
                CanReorderItems="True"
                CanDragItems="True"
                AllowDrop="True"
                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                ScrollViewer.HorizontalScrollMode="Enabled"
                ScrollViewer.VerticalScrollMode="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Hidden"
                SelectionChanged="TabList_SelectionChanged"
                DragItemsCompleted="TabList_DragItemsCompleted">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="core:BrowserTabModel">
                        <Grid MinWidth="150" MaxWidth="240" Padding="8,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <ProgressRing
                                    Width="12"
                                    Height="12"
                                    IsActive="{Binding IsLoading}"
                                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    MaxWidth="180"
                                    Text="{Binding Title}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button
                                Grid.Column="1"
                                Style="{StaticResource TabCloseButtonStyle}"
                                Tag="{Binding Id}"
                                Click="TabClose_Click"
                                ToolTipService.ToolTip="Close tab">
                                <FontIcon FontSize="10" Glyph="&#xE711;" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <Button
                Grid.Column="1"
                Margin="0,0,8,0"
                Width="36"
                Height="34"
                VerticalAlignment="Center"
                Style="{StaticResource ToolbarButtonStyle}"
                AutomationProperties.AutomationId="NewTabButton"
                Click="NewTab_Click"
                ToolTipService.ToolTip="New tab">
                <FontIcon Glyph="&#xE710;" />
            </Button>
        </Grid>

        <!-- Toolbar -->
        <Grid Grid.Row="1" Padding="8,6" ColumnSpacing="4" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="BackButton" Grid.Column="0" Style="{StaticResource ToolbarButtonStyle}" Click="Back_Click" ToolTipService.ToolTip="Back">
                <FontIcon Glyph="&#xE72B;" />
            </Button>
            <Button x:Name="ForwardButton" Grid.Column="1" Style="{StaticResource ToolbarButtonStyle}" Click="Forward_Click" ToolTipService.ToolTip="Forward">
                <FontIcon Glyph="&#xE72A;" />
            </Button>
            <Button x:Name="ReloadButton" Grid.Column="2" Style="{StaticResource ToolbarButtonStyle}" Click="Reload_Click" ToolTipService.ToolTip="Reload">
                <FontIcon x:Name="ReloadIcon" Glyph="&#xE72C;" />
            </Button>
            <AutoSuggestBox
                x:Name="AddressBar" AutomationProperties.AutomationId="AddressBar"
                Grid.Column="3"
                Margin="4,0"
                Height="34"
                VerticalContentAlignment="Center"
                PlaceholderText="Search or enter a web address"
                TextMemberPath="Label"
                TextChanged="AddressBar_TextChanged"
                SuggestionChosen="AddressBar_SuggestionChosen"
                QuerySubmitted="AddressBar_QuerySubmitted" />
            <Button x:Name="GoButton" Grid.Column="4" AutomationProperties.AutomationId="GoButton" Style="{StaticResource ToolbarButtonStyle}" Click="GoButton_Click" ToolTipService.ToolTip="Go">
                <FontIcon Glyph="&#xE768;" />
            </Button>
            <ComboBox
                x:Name="SearchEngineBox" AutomationProperties.AutomationId="SearchEngineBox"
                Grid.Column="5"
                Width="126"
                Height="34"
                DisplayMemberPath="Name"
                SelectionChanged="SearchEngineBox_SelectionChanged"
                ToolTipService.ToolTip="Search engine" />
            <Button x:Name="BookmarksButton" AutomationProperties.AutomationId="BookmarksButton" Grid.Column="6" Style="{StaticResource ToolbarButtonStyle}" Click="Bookmarks_Click" ToolTipService.ToolTip="Bookmarks">
                <FontIcon x:Name="BookmarkIcon" Glyph="&#xE734;" />
            </Button>
            <Button x:Name="DownloadsButton" AutomationProperties.AutomationId="DownloadsButton" Grid.Column="7" Style="{StaticResource ToolbarButtonStyle}" Click="Downloads_Click" ToolTipService.ToolTip="Downloads">
                <FontIcon Glyph="&#xE896;" />
            </Button>
            <Button x:Name="ProfileButton" AutomationProperties.AutomationId="ProfileButton" Grid.Column="8" Style="{StaticResource ToolbarButtonStyle}" Click="Profile_Click" ToolTipService.ToolTip="Profiles">
                <FontIcon Glyph="&#xE77B;" />
            </Button>
            <Button x:Name="AiButton" AutomationProperties.AutomationId="AiButton" Grid.Column="9" Style="{StaticResource ToolbarButtonStyle}" Click="Ai_Click" ToolTipService.ToolTip="AI web panel">
                <FontIcon Glyph="&#xE8BD;" />
            </Button>
            <Button x:Name="MenuButton" AutomationProperties.AutomationId="MenuButton" Grid.Column="10" Style="{StaticResource ToolbarButtonStyle}" Click="Menu_Click" ToolTipService.ToolTip="Browser menu">
                <FontIcon Glyph="&#xE712;" />
            </Button>
            <ProgressRing x:Name="LoadingRing" Grid.Column="11" Width="18" Height="18" IsActive="False" />
        </Grid>

        <!-- Find in page -->
        <Grid x:Name="FindBar" AutomationProperties.AutomationId="FindBar" Grid.Row="2" Padding="8,4" ColumnSpacing="6" Visibility="Collapsed" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon Grid.Column="0" Glyph="&#xE721;" FontSize="14" VerticalAlignment="Center" />
            <TextBox
                x:Name="FindBox" AutomationProperties.AutomationId="FindBox"
                Grid.Column="1"
                Height="32"
                PlaceholderText="Find in page"
                KeyDown="FindBox_KeyDown" />
            <TextBlock x:Name="FindCount" AutomationProperties.AutomationId="FindCount" Grid.Column="2" VerticalAlignment="Center" MinWidth="70" Text="0/0" />
            <Button x:Name="FindGoButton" Grid.Column="3" AutomationProperties.AutomationId="FindGoButton" Style="{StaticResource ToolbarButtonStyle}" Click="FindGo_Click" ToolTipService.ToolTip="Find">
                <FontIcon Glyph="&#xE721;" />
            </Button>
            <Button Grid.Column="4" Style="{StaticResource ToolbarButtonStyle}" Click="FindPrevious_Click" ToolTipService.ToolTip="Previous match">
                <FontIcon Glyph="&#xE70E;" />
            </Button>
            <Button Grid.Column="5" Style="{StaticResource ToolbarButtonStyle}" Click="FindNext_Click" ToolTipService.ToolTip="Next match">
                <FontIcon Glyph="&#xE70D;" />
            </Button>
            <Button Grid.Column="6" Style="{StaticResource ToolbarButtonStyle}" AutomationProperties.AutomationId="FindCloseButton" Click="FindClose_Click" ToolTipService.ToolTip="Close find">
                <FontIcon Glyph="&#xE711;" />
            </Button>
        </Grid>

        <!-- Content + AI side panel -->
        <Grid Grid.Row="3" x:Name="ContentGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="AiColumn" Width="0" />
            </Grid.ColumnDefinitions>
            <Grid x:Name="WebViewHost" Grid.Column="0" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" />

            <Border x:Name="AiPanelHost" AutomationProperties.AutomationId="AiPanelHost" Grid.Column="1" Visibility="Collapsed" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Padding="10,0,4,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="AI web panel" VerticalAlignment="Center" FontWeight="SemiBold" />
                        <Button Grid.Column="1" Style="{StaticResource ToolbarButtonStyle}" AutomationProperties.AutomationId="AiCloseButton" Click="AiClose_Click" ToolTipService.ToolTip="Close AI panel">
                            <FontIcon Glyph="&#xE711;" />
                        </Button>
                    </Grid>
                    <ComboBox x:Name="AiServiceBox" Grid.Row="1" Margin="8,2" HorizontalAlignment="Stretch" DisplayMemberPath="Name" SelectionChanged="AiServiceBox_SelectionChanged" />
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Padding="8,2" Spacing="2">
                        <Button Content="Page info" Click="AiCopyInfo_Click" ToolTipService.ToolTip="Copy page title and URL" />
                        <Button Content="Article" Click="AiCopyArticle_Click" ToolTipService.ToolTip="Copy extracted article text" />
                    </StackPanel>
                    <WebView2 x:Name="AiWebView" AutomationProperties.AutomationId="AiWebView" Grid.Row="3" Margin="0,2" />
                    <TextBlock x:Name="AiStatusText" Grid.Row="4" Padding="8,4" FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Context is copied only when you choose it; it is never sent automatically." />
                </Grid>
            </Border>

            <!-- Reader overlay -->
            <Grid x:Name="ReaderHost" AutomationProperties.AutomationId="ReaderHost" Grid.ColumnSpan="2" Visibility="Collapsed" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="44" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Padding="10,0,4,0" Background="{ThemeResource LayerFillColorDefaultBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ReaderTitleText" AutomationProperties.AutomationId="ReaderTitleText" Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="Reader" />
                    <ComboBox x:Name="ReaderFontBox" Grid.Column="1" Width="92" Height="32" Margin="4,0" SelectionChanged="ReaderFontBox_SelectionChanged" />
                    <ComboBox x:Name="ReaderThemeBox" Grid.Column="2" Width="96" Height="32" Margin="4,0" SelectionChanged="ReaderThemeBox_SelectionChanged" />
                    <Button Grid.Column="3" Style="{StaticResource ToolbarButtonStyle}" Click="ReaderSmaller_Click" ToolTipService.ToolTip="Smaller text"><FontIcon Glyph="&#xE1A3;" /></Button>
                    <Button Grid.Column="4" Style="{StaticResource ToolbarButtonStyle}" Click="ReaderLarger_Click" ToolTipService.ToolTip="Larger text"><FontIcon Glyph="&#xE1A4;" /></Button>
                    <Button Grid.Column="5" Style="{StaticResource ToolbarButtonStyle}" AutomationProperties.AutomationId="ReaderCloseButton" Click="ReaderClose_Click" ToolTipService.ToolTip="Return to page"><FontIcon Glyph="&#xE711;" /></Button>
                </Grid>
                <WebView2 x:Name="ReaderWebView" Grid.Row="1" />
            </Grid>
        </Grid>

        <!-- Status -->
        <Border Grid.Row="4" Padding="10,2" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <TextBlock x:Name="StatusText" AutomationProperties.AutomationId="StatusText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
        </Border>
    </Grid>
</Window>
